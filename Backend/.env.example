# =============================================================================
# Medora Backend — environment template
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, and never put real
# values into this template.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# Use 127.0.0.1 rather than "localhost" if the server is bound to IPv4 only;
# otherwise Node may resolve localhost to ::1 and the connection will fail.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=medora_db
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- HTTP server ------------------------------------------------------------
PORT=5000

# --- Runtime ----------------------------------------------------------------
# "development" locally. "production" forces Secure cookies and SameSite=strict,
# which will not work over plain http://localhost.
NODE_ENV=development

# Credentialed CORS allowlist — the origin of the Next.js frontend.
FRONTEND_ORIGIN=http://localhost:3000
