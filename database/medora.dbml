// =============================================================================
// TABLE GROUPS
// =============================================================================

TableGroup "Identity & Access" {
  users
  roles
  user_roles
  permissions
  role_permissions
  sessions
}

TableGroup "Profiles & Care Access" {
  patient_profiles
  doctor_profiles
  specialties
  care_relationships
}

TableGroup "Scheduling & Follow-Up" {
  clinic_locations
  doctor_availability
  doctor_time_off
  appointments
  appointment_status_history
  follow_ups
  appointment_proposals
}

TableGroup "Consultations & Transcripts" {
  consultations
  consultation_consents
  consultation_recordings
  transcripts
  transcript_versions
  transcript_approvals
}

TableGroup "AI Agents & Reports" {
  agent_executions
  medical_reports
  report_versions
  report_approvals
  report_deliveries
  record_update_proposals
}

TableGroup "Medical Records" {
  medical_conditions
  patient_medications
  patient_allergies
  medical_history_entries
  test_orders
  test_results
}

TableGroup "Reference Knowledge (OCR & RAG)" {
  reference_documents
  reference_document_versions
  document_extraction_jobs
  reference_chunks
  rag_queries
  rag_citations
}

TableGroup "Operations & Audit" {
  notifications
  audit_logs
  security_events
}

TableGroup "Platform Infrastructure" {
  schema_migrations
}
