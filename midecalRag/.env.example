# CareOS Medical RAG service - example environment file.
# Copy to .env and fill real values. NEVER commit the real .env (see .gitignore).
# Variable NAMES only are shared between teams; never put secrets here.

# --- service auth (Backend sends this value in the X-API-Key header) ---
RAG_API_KEY=change-me-generate-a-long-random-string

# --- vector store ---
# Production: Qdrant Cloud. Local development fallback: docker-compose.yml
# (then QDRANT_URL=http://localhost:6333 and QDRANT_API_KEY stays empty).
QDRANT_URL=https://your-qdrant-cloud-instance.example:6333
QDRANT_API_KEY=
COLLECTION_NAME=careos_medical_records
# Transient Qdrant network/timeout retries (exponential backoff).
QDRANT_TIMEOUT_SECONDS=15
QDRANT_RETRY_ATTEMPTS=3
QDRANT_RETRY_WAIT_SECONDS=0.5

# --- embedding models (FastEmbed ids) ---
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
# Phase 4: batch size for FastEmbed calls; load both models once at startup.
EMBED_BATCH_SIZE=32
EMBED_WARMUP_ON_STARTUP=true

# --- manifest / audit database ---
DB_URL=sqlite:///./rag_manifest.db

# --- LLM (OpenRouter is the ONLY provider; OpenAI-compatible API, no fallback) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# Phase 6: answer length cap and retry policy for rate limits/timeouts.
# Must cover reasoning/thinking tokens too (Gemini 2.5): 700 truncated a brief.
LLM_MAX_TOKENS=2000
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_WAIT_SECONDS=1.0

# --- retrieval tunables (Phase 5) ---
# Over-fetch before chronological re-ranking; plan band is 30..50.
WIDE_K=40
FINAL_PARENTS=5
# 0.0 disables the relevance gate. Phase 8 calibrated it on the 35-case golden
# set: every floor above 0 either drops expected documents or leaves recall flat
# while irrelevant parents still pass, so the gate stays OFF.
# Reference points: 0.40 -> recall 90.3% (3 expected docs lost), 0.50 -> 67.7%.
RELEVANCE_FLOOR=0.0
RECENCY_WEIGHT=0.1
RECENCY_DECAY_DAYS=180
LATEST_KEYWORDS_EN=latest,last,most recent,current,currently,newest,recent
LATEST_KEYWORDS_AR=اخر,اخير,احدث,حالي,حاليا,الحالي
TREND_KEYWORDS_EN=change,changed,trend,trending,over time,compare,comparison,history
TREND_KEYWORDS_AR=تغير,تطور,مقارنه,مقارنة,علي مدار,على مدار,تاريخ
PARENT_MAX_CHARS=6000
# MiniLM-L12-v2 truncates at 128 tokens; keep each child (prefix included) short.
CHILD_MAX_CHARS=480

# --- query expansion / translation (Phase 5 retrieval step only) ---
# OpenRouter is primary, Gemini is the fallback for THIS step only (generation
# stays OpenRouter-only). Any failure degrades to the original query.
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_VARIANTS=3
QUERY_EXPANSION_TIMEOUT_SECONDS=10
GEMINI_API_KEY=
# OpenAI-compatible endpoint so the same `openai` SDK is reused.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- patient summary / doctor brief (Phase 7) ---
# The brief has no question to infer a language from; the request may set it.
CLINIC_DEFAULT_LANGUAGE=ar
SUMMARY_DOCS_PER_TYPE=3
SUMMARY_MAX_DOCUMENTS=9
SUMMARY_MAX_CHARS=12000

# --- chat history window ---
HISTORY_MAX_MESSAGES=5
HISTORY_MAX_CHARS=1000

# --- ingestion limits / privacy ---
MAX_TEXT_CHARS=100000
DEIDENTIFY_ENABLED=true
RECOVERY_STALE_SECONDS=900

# --- security, rate limiting and audit (Phase 9) ---
# Internal service: CORS is closed unless origins are listed (comma-separated).
CORS_ALLOWED_ORIGINS=
# Requests per minute per (API key, client host). 0 disables the limiter.
RATE_LIMIT_PER_MINUTE=60
AUDIT_ENABLED=true
AUDIT_LOG_PATH=logs/audit.jsonl
# Salt for patient_id hashing (SHA-256). Set a long random value in production;
# if empty a random per-process salt is used and hashes differ across restarts.
AUDIT_HASH_SALT=

# --- misc ---
CLINIC_TIMEZONE=Africa/Cairo
LOG_LEVEL=INFO
